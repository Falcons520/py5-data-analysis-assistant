{
  "name": "AI 数据分析助手",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "server/main.py",
        "static/index.html"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "sudo apt-get update && sudo apt-get install -y fonts-wqy-zenhei fonts-noto-cjk; pip3 install --user -r requirements-dev.txt; echo '✅ 依赖安装完成'",
  "postAttachCommand": {
    "server": "uvicorn server.main:app --host 0.0.0.0 --port 8000"
  },
  "portsAttributes": {
    "8000": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000
  ]
}
